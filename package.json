{
  "name": "surshim",
  "version": "0.0.0",
  "description": "RPG 2D cosy et survie en JavaScript natif (canvas), sans framework ni bundler.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "http-server . -c-1 -p 8081",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/core/**\" --test-coverage-include=\"data/**\" --test-coverage-lines=90 \"tests/**/*.test.js\"",
    "spec:check": "node tools/specCheck.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run duplication && npm test && npm run spec:check",
    "duplication": "jscpd",
    "quality:report": "node tools/qualityReport.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsdoc": "^65.2.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^15.14.0",
    "http-server": "^14.1.1",
    "jscpd": "^5.4.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
